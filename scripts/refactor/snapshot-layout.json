{
  "schema_version": 1,
  "components": {
    "platform": {
      "target_directory": "gidong-platform",
      "mappings": [
        {"from": "README.md", "to": "README.md"},
        {"from": "host", "to": "host"},
        {"from": "web", "to": "web"},
        {"from": "launcher", "to": "launcher"},
        {"from": "schemas", "to": "schemas"},
        {"from": "packages/python/controlstudio-contracts", "to": "packages/python/controlstudio-contracts"},
        {"from": "packages/typescript/controlstudio-contracts", "to": "packages/typescript/controlstudio-contracts"},
        {"from": "mocks", "to": "mocks"},
        {"from": "conformance", "to": "conformance"},
        {"from": "docs", "to": "docs"},
        {"from": "scripts/contracts", "to": "scripts/contracts"},
        {"from": "scripts/refactor", "to": "scripts/refactor"},
        {"from": "packaging", "to": "packaging"}
      ],
      "required_paths": [
        "host/pyproject.toml",
        "packages/python/controlstudio-contracts/pyproject.toml",
        "packages/python/controlstudio-contracts/src/controlstudio_contracts/v1.py",
        "launcher/pyproject.toml",
        "web/package.json",
        "schemas/agent/v1/agent-manifest.schema.json",
        "packages/typescript/controlstudio-contracts/package.json",
        "packages/typescript/controlstudio-contracts/src/index.ts",
        "README.md",
        "docs/README.md",
        "scripts/contracts/contract_guard.py",
        "scripts/refactor/refactor_audit.py",
        "packaging/scripts/build_standalone.py",
        "packaging/scripts/assemble_portable.py",
        "packaging/tests/test_bom.py"
      ]
    },
    "agent": {
      "target_directory": "gidong-agent",
      "mappings": [{"from": "agent", "to": "."}],
      "required_paths": [
        "pyproject.toml",
        "src/controlstudio_agent/sidecar.py",
        "src/controlstudio_agent/protocol.py",
        "packaging/entrypoints/agent_main.py",
        "scripts/build_standalone.py",
        "tests/test_packaging_build.py"
      ]
    },
    "plc-mcp": {
      "target_directory": "gidong-plc-mcp",
      "mappings": [{"from": "mcp", "to": "."}],
      "required_paths": [
        "pyproject.toml",
        "src/xg5000_control/server.py",
        "src/xg5000_control/change_transactions.py",
        "packaging/entrypoints/plc_mcp_main.py",
        "scripts/build_standalone.py",
        "tests/test_packaging_build.py"
      ]
    }
  }
}
