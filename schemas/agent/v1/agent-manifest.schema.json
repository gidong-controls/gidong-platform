{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlstudio.dev/schemas/agent/v1/agent-manifest.schema.json",
  "title": "ControlStudio Agent Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "agent_id", "capabilities"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "agent_id": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}}
  }
}
