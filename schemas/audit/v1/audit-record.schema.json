{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlstudio.dev/schemas/audit/v1/audit-record.schema.json",
  "title": "ControlStudio Audit Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "occurred_at", "actor_id", "action", "trace_id", "run_id", "operation_id", "outcome", "details"],
  "properties": {
    "audit_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "run_id": {"type": ["string", "null"]},
    "operation_id": {"type": ["string", "null"]},
    "outcome": {"enum": ["accepted", "rejected", "completed", "failed", "quarantined"]},
    "details": {"type": "object"}
  }
}
